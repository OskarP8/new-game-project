text = "Insightful."
speaker_name = ""
speaker_role = ""

[sub_resource type="Resource" id="Resource_1lkwx"]
script = ExtResource("21_mg63h")
text = "Can you, uh...<pause=0.5> dim a little?<pause=0.5> I can't see."
speaker_name = "You"
speaker_role = "player"

[sub_resource type="Resource" id="Resource_tcx1c"]
script = ExtResource("21_mg63h")
text = "I am the embodiment of celestial brilliance."
speaker_name = ""
speaker_role = ""

[sub_resource type="Resource" id="Resource_g5rke"]
script = ExtResource("21_mg63h")
text = "Yeah<pause=0.5>, well<pause=0.5>, celestial brilliance is in my eyeballs."
speaker_name = "You"
speaker_role = "player"

[sub_resource type="Resource" id="Resource_1r3if"]
script = ExtResource("21_mg63h")
text = "..."
speaker_name = ""
speaker_role = ""

[sub_resource type="Resource" id="Resource_rlgaf"]
script = ExtResource("21_mg63h")
text = "No.<pause=0.5> I won't \"dim\" my light for some mortal."
speaker_name = ""
speaker_role = ""

[sub_resource type="Resource" id="Resource_rrle4"]
script = ExtResource("21_mg63h")
text = "Now speak.<pause=0.5> Before my patience fades."
speaker_name = ""
speaker_role = ""

[sub_resource type="Resource" id="Resource_gqejr"]
script = ExtResource("21_mg63h")
text = "The Iron Men attacked our village.<pause=0.5> Can you help us defeat them?"
speaker_name = "You"
speaker_role = "player"

[sub_resource type="Resource" id="Resource_mfffs"]
script = ExtResource("21_mg63h")
text = "If you seek my power... prove you are worthy of it."
speaker_name = ""
speaker_role = ""

